# ── Database ────────────────────────────────────────────────────────────────
# Local development: a file next to the repo.
DATABASE_URL="file:local.db"
# Only needed for a remote database.
DATABASE_AUTH_TOKEN=""
#
# On Vercel these are supplied by the Turso Marketplace integration under its
# own names (DATABASE_TURSO_DATABASE_URL / DATABASE_TURSO_AUTH_TOKEN); the app
# accepts those too, so there is nothing to copy by hand.
# See src/lib/server/db/env.ts

# ── App ─────────────────────────────────────────────────────────────────────
# The public origin. Must match exactly, including the scheme and port.
ORIGIN="http://localhost:5173"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Models ──────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# https://console.mistral.ai — used for Document AI (OCR).
MISTRAL_API_KEY=""

# ── File storage ────────────────────────────────────────────────────────────
# Vercel Blob. Leave empty locally: uploads fall back to ./.rowbot-uploads
BLOB_READ_WRITE_TOKEN=""

# ── Access control ──────────────────────────────────────────────────────────
# Rowbot is a public demo running on real, paid API keys, so both halves of the
# spend are bounded: how many accounts exist, and what each one may use.
#
# Sign-up invite codes, comma-separated. Issue and revoke by editing this value.
# UNSET OR EMPTY CLOSES SIGN-UP — a missing config never opens the door.
ROWBOT_INVITE_CODES=""
# Addresses that bypass the free allowance, comma-separated. Operator accounts.
# Everyone else gets one document of at most ten pages and a handful of agent
# turns, until they save their own provider keys in Settings.
# See src/lib/server/entitlements.ts
ROWBOT_UNLIMITED_EMAILS=""

# ── Tracing (optional) ──────────────────────────────────────────────────────
# LANGSMITH_API_KEY=""
# LANGSMITH_TRACING="true"
# LANGSMITH_PROJECT="rowbot"
