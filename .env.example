# ── Database ────────────────────────────────────────────────────────────────
# Local development: a file next to the repo.
# Production: your Turso URL, e.g. libsql://rowbot-you.turso.io
DATABASE_URL="file:local.db"
# Only needed for a remote (Turso) database.
DATABASE_AUTH_TOKEN=""

# ── App ─────────────────────────────────────────────────────────────────────
# The public origin. Must match exactly, including the scheme and port.
ORIGIN="http://localhost:5173"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Models ──────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# https://console.mistral.ai — used for Document AI (OCR).
MISTRAL_API_KEY=""

# ── File storage ────────────────────────────────────────────────────────────
# Vercel Blob. Leave empty locally: uploads fall back to ./.rowbot-uploads
BLOB_READ_WRITE_TOKEN=""

# ── Tracing (optional) ──────────────────────────────────────────────────────
# LANGSMITH_API_KEY=""
# LANGSMITH_TRACING="true"
# LANGSMITH_PROJECT="rowbot"
